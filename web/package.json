    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.5",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "eslint": "^10.8.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
