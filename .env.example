# Current local EvoKB configuration. Copy to .env and replace the local secret placeholders.
# The default compose uses an independent evokb-local project; it never migrates old/target volumes.
# Existing external MinerU and model services must be configured explicitly. No weights are downloaded.

# Loopback host ports (changing ports does not expose an external interface).
EKB_SERVER_PORT=18080
EKB_POSTGRES_PORT=15432
EKB_REDIS_PORT=16379
EKB_MINIO_PORT=19000
EKB_MINIO_CONSOLE_PORT=19001
EKB_MILVUS_PORT=19530
EKB_MILVUS_HEALTH_PORT=19091
EKB_APP_IMAGE=evokb:local

# Durable local infrastructure. Use distinct strong local passwords before starting.
EKB_POSTGRES_DATABASE=evokb
EKB_POSTGRES_USER=evokb
EKB_POSTGRES_PASSWORD=[REDACTED_SECRET]
EKB_DB_POOL_SIZE=6
EKB_MINIO_ROOT_USER=ekbadmin
EKB_MINIO_ROOT_PASSWORD=[REDACTED_SECRET]
EKB_MINIO_BUCKET=enterprise-kb
EKB_MINIO_REGION=us-east-1
EKB_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
EKB_MINIO_BROWSER_ORIGINS=http://127.0.0.1:18080,http://localhost:18080
EKB_MILVUS_BUCKET=evokb-milvus
EKB_MILVUS_COLLECTION=knowledge_chunks
EKB_MILVUS_TOKEN=
EKB_KNOWLEDGE_BASE_ID=enterprise
EKB_RAW_STREAM=evokb:local:raw:v1
EKB_RAW_STREAM_GROUP=raw-ingestion

# External MinerU: frozen 3.4.5 / hybrid-engine / medium / auto, stage maximum600s, single file256MiB.
# Leave blank to browse/administer first. PDF/Office parsing remains unavailable until connected.
EKB_MINERU_URL=
EKB_MINERU_LANGUAGE=ch
EKB_MINERU_POLL_MS=500

# Approved external chat: small gpt-5.6-luna, large gpt-5.6-terra (fixed by compose).
EKB_CHAT_BASE_URL=
EKB_CHAT_API_KEY=
EKB_CHAT_PROXY_HOST=
EKB_CHAT_PROXY_PORT=
EKB_CHAT_TIMEOUT_SECONDS=120
EKB_QUERY_CONTEXT_CHARS=24000

# External Qwen3-VL-Embedding-2B1024 and Qwen3-VL-Reranker-2B (fixed by compose).
# URLs must be reachable FROM the app container; host127.0.0.1 is not a container endpoint.
EKB_EMBEDDING_BASE_URL=
EKB_EMBEDDING_API_KEY=
EKB_EMBED_BATCH_SIZE=16
EKB_EMBED_TIMEOUT_SECONDS=120
EKB_EMBED_MAX_CONCURRENCY=1
EKB_RERANK_BASE_URL=
EKB_RERANK_API_KEY=
EKB_RERANK_TIMEOUT_SECONDS=30
EKB_RERANK_MAX_CONCURRENCY=1
EKB_RERANK_MAX_CANDIDATES=20
EKB_RERANK_MAX_CHARS=400

# Bind directory contains manifest.json and six SHA-verified tokenizer assets, not weights.
# Empty manifest keeps the UI available; Raw fails explicitly instead of estimating character counts.
EKB_TOKENIZER_ASSETS_DIR=./tokenizer
EKB_EMBED_TOKENIZER_MANIFEST=
# After provisioning approved assets, set EKB_EMBED_TOKENIZER_MANIFEST=/app/tokenizer/manifest.json.

# Runtime. The compose sets the existing256MiB effective single-file limit and disables fallback.
EKB_SESSION_TTL_HOURS=12
EKB_SESSION_COOKIE_SECURE=false
EKB_MAX_BATCH_UPLOAD_MIB=4096
EKB_MAX_BATCH_EXPANDED_MIB=16384
EKB_MAX_BATCH_FILES=2000
EKB_INGEST_POLL_MS=1000
EKB_INGEST_CLAIM_LIMIT=1
EKB_INGEST_WORKERS=3
