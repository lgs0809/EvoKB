# EvoKB deployment configuration
# Copy this file to the repository root as .env before Docker Compose startup.
# Replace every [REDACTED_SECRET] / example endpoint.

# Host bindings
EKB_BIND_ADDRESS=127.0.0.1
EKB_SERVER_PORT=18080
EKB_MYSQL_PORT=23316
EKB_MINIO_PORT=19000
EKB_MINIO_CONSOLE_PORT=19001
EKB_OPENSEARCH_PORT=19200
EKB_NEO4J_HTTP_PORT=17474
EKB_NEO4J_BOLT_PORT=17687

# Durable infrastructure
EKB_MYSQL_DATABASE=enterprise_kb
EKB_MYSQL_USER=ekb
EKB_MYSQL_PASSWORD=[REDACTED_SECRET]
EKB_MYSQL_ROOT_PASSWORD=[REDACTED_SECRET]
EKB_MYSQL_POOL_SIZE=20
EKB_MINIO_ROOT_USER=ekbadmin
EKB_MINIO_ROOT_PASSWORD=[REDACTED_SECRET]
EKB_MINIO_BUCKET=enterprise-kb
EKB_MINIO_REGION=us-east-1
# Browser-accessible MinIO endpoint used to generate source links.
EKB_MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:19000
EKB_OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
EKB_RAW_INDEX=ekb_raw_v1
EKB_DERIVED_INDEX=ekb_derived_v1
EKB_NEO4J_AUTH=neo4j/[REDACTED_SECRET]
EKB_NEO4J_DATABASE=neo4j
EKB_NEO4J_HEAP_INITIAL=256m
EKB_NEO4J_HEAP_MAX=512m
EKB_NEO4J_PAGECACHE=256m

# Existing external MinerU Pipeline endpoint.
EKB_MINERU_URL=http://mineru.example.invalid:8000
EKB_MINERU_POLL_MS=500
EKB_MINERU_PARSE_METHOD=auto
EKB_MINERU_LANGUAGE=ch

# Existing external OpenAI-compatible chat endpoint.
EKB_CHAT_BASE_URL=https://chat.example.invalid
EKB_CHAT_API_KEY=[REDACTED_SECRET]
# Optional HTTP proxy for a remote Chat gateway (leave blank for direct access).
EKB_CHAT_PROXY_HOST=
EKB_CHAT_PROXY_PORT=
EKB_SMALL_MODEL=your-small-model
EKB_LARGE_MODEL=your-large-model
# Optional extractive compilation fallback: disabled, on-failure, or always.
EKB_ASSISTANT_FALLBACK=disabled
EKB_QUERY_CONTEXT_CHARS=24000

# Existing external OpenAI-compatible embedding endpoint.
EKB_EMBEDDING_BASE_URL=https://embedding.example.invalid
EKB_EMBEDDING_API_KEY=[REDACTED_SECRET]
EKB_EMBEDDING_MODEL=your-embedding-model
EKB_EMBED_DIMS=1024
EKB_EMBED_BATCH_SIZE=16
EKB_EMBED_TIMEOUT_SECONDS=120

# Existing external rerank endpoint exposing POST /v1/rerank.
EKB_RERANK_BASE_URL=https://rerank.example.invalid
EKB_RERANK_API_KEY=[REDACTED_SECRET]
EKB_RERANK_MODEL=your-rerank-model
EKB_RERANK_TIMEOUT_SECONDS=30
EKB_RERANK_MAX_CANDIDATES=20
EKB_RERANK_MAX_CHARS=400

# Runtime and security
EKB_SESSION_TTL_HOURS=12
EKB_SESSION_COOKIE_SECURE=false
EKB_TRUST_PROXY_HEADERS=false
EKB_MAX_UPLOAD_BYTES=536870912
EKB_MAX_BATCH_UPLOAD_MIB=4096
EKB_MAX_BATCH_EXPANDED_MIB=16384
EKB_MAX_BATCH_FILES=2000
EKB_INGEST_POLL_MS=1000
EKB_INGEST_CLAIM_LIMIT=1
EKB_GENERATION_EFFECTIVE_HIT_THRESHOLD=3
